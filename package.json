		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"bun-plugin-tailwind": "^0.1.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2"
	}
}
